# Server-only. Keep disabled until the reviewed deployment and mailbox pilot.
FIELD_SALES_MAIL_ENABLED=false
FIELD_SALES_MAIL_TENANT_IDS=[]
FIELD_SALES_MAIL_PROVIDER_KEYS={}
FIELD_SALES_MAIL_SECRET_KEYS={}
FIELD_SALES_MAIL_SCHEDULER_SECRET=
FIELD_SALES_MAIL_DATABASE_KEY_NAME=default
# SUPABASE_URL and SUPABASE_SECRET_KEYS are supplied by the Edge runtime.
# SUPABASE_SERVICE_ROLE_KEY is supported only as a legacy fallback when the
# new secret-key map is absent; publishable/anon keys are rejected.
# Never include these values in a Flutter build or checked-in configuration.
