          "column_checks": [
            "CHECK (((header_discount_percent >= (0)::numeric) AND (header_discount_percent <= (100)::numeric)))"
          ]
        }
      },
      "constraints": {
        "check": [
          "CHECK ((valid_until >= quotation_date))",
          "CHECK (((workflow_definition_id IS NULL) = (workflow_revision IS NULL)))",
          "CHECK (((header_discount_amount = (0)::numeric) OR (header_discount_percent IS NULL)))",
          "CHECK (((line_discount_total + header_discount_total) = discount_total))",
          "CHECK ((header_discount_total <= (subtotal - line_discount_total)))",
          "CHECK ((((currency_code = base_currency_code) AND (exchange_rate = (1)::numeric)) OR (currency_code <> base_currency_code)))"
        ]
      }
