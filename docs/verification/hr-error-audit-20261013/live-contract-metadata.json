  "inspected_definitions": [
    {
      "name": "people_hr_reviews",
      "definition": "CREATE OR REPLACE FUNCTION api.people_hr_reviews(p_tenant_id uuid, p_legal_entity_id uuid, p_branch_id uuid, p_employee_id uuid, p_after uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare v_self boolean;v_items jsonb;begin\n v_self:=people_private.active_link(p_tenant_id,p_legal_entity_id,p_branch_id,p_employee_id)\n and core.has_permission(p_tenant_id,'people.self.view',p_legal_entity_id,p_branch_id)\n and not core.has_permission(p_tenant_id,'people.reviews.view',p_legal_entity_id,p_branch_id);\n perform people_private.require_access(p_tenant_id,p_legal_entity_id,p_branch_id,p_employee_id,\n case when v_self then 'people.self.view' else 'people.reviews.view' end);\n perform people_private.content_available(p_tenant_id,p_legal_entity_id,p_employee_id);\n select coalesce(jsonb_agg(jsonb_build_object('id',q.id,'version',q.version,'revision_id',q.revision_id,\n 'reviewer_id',q.reviewer_id,'status',q.status,'start_date',q.start_date,'end_date_exclusive',q.end_date_exclusive,\n 'body',q.body,'recorded_by',q.recorded_by,'recorded_at',q.recorded_at) order by q.id),'[]') into v_items\n from(select r.*,v.body,v.recorded_by,v.recorded_at from people_private.reviews r\n join people_private.review_revisions v on v.id=r.revision_id\n where r.tenant_id=p_tenant_id and r.legal_entity_id=p_legal_entity_id and r.branch_id=p_branch_id\n and r.employee_id=p_employee_id and r.status<>'erased' and (not v_self or r.status<>'draft')\n and (r.status<>'draft' or r.created_by=auth.uid() or core.has_permission(p_tenant_id,'people.reviews.manage',p_legal_entity_id,p_branch_id))\n and (p_after is null or r.id>p_after) order by r.id limit 51) q;\n return jsonb_build_object('tenant_id',p_tenant_id,'legal_entity_id',p_legal_entity_id,'branch_id',p_branch_id,\n 'employee_id',p_employee_id,'items',v_items-50,'next_cursor',case when jsonb_array_length(v_items)>50 then v_items->49->>'id' end);\nend $function$\n"
    },
    {
      "name": "people_payroll_correction_authorize",
      "definition": "CREATE OR REPLACE FUNCTION api.people_payroll_correction_authorize(p_tenant_id uuid, p_legal_entity_id uuid, p_branch_id uuid, p_capability text)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$begin\n perform people_payroll.correction_access(p_tenant_id,p_legal_entity_id,p_branch_id,p_capability,true);\n return jsonb_build_object('tenant_id',p_tenant_id,'legal_entity_id',p_legal_entity_id,'branch_id',p_branch_id,\n  'actor_id',auth.uid(),'capability',p_capability,'authorized',true);end $function$\n"
    },
    {
      "name": "people_payroll_payslip",
      "definition": "CREATE OR REPLACE FUNCTION api.people_payroll_payslip(p_tenant_id uuid, p_legal_entity_id uuid, p_branch_id uuid, p_payslip_id uuid, p_after_code text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare payload jsonb;lines jsonb;begin\n perform people_payroll.require_access(p_tenant_id,p_legal_entity_id,p_branch_id,'people.payroll.payslip.view',true);\n select people_payroll.payslip_payload(id) into payload from people_payroll.payslips where tenant_id=p_tenant_id and legal_entity_id=p_legal_entity_id and branch_id=p_branch_id and id=p_payslip_id;\n if payload is null then raise exception using errcode='P0002',message='PAYROLL_PAYSLIP_NOT_FOUND';end if;\n select coalesce(jsonb_agg(value order by value->>'code'),'[]'::jsonb) into lines from\n  (select value from jsonb_array_elements(payload->'lines') where p_after_code is null or value->>'code'>p_after_code order by value->>'code' limit 51) q;\n return jsonb_build_object('tenant_id',p_tenant_id,'legal_entity_id',p_legal_entity_id,'branch_id',p_branch_id,'payslip',payload-'lines',\n  'lines',lines-50,'next_code',case when jsonb_array_length(lines)>50 then lines->49->>'code' end);\nend $function$\n"
    },
    {
      "name": "people_payroll_self_payslips",
      "definition": "CREATE OR REPLACE FUNCTION api.people_payroll_self_payslips(p_tenant_id uuid, p_legal_entity_id uuid, p_branch_id uuid, p_after uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare employee uuid;items jsonb;begin\n perform people_payroll.require_access(p_tenant_id,p_legal_entity_id,p_branch_id,'people.payroll.payslip.self',true);\n select l.employee_id into employee from people_private.account_links l join core.memberships m\n  on m.tenant_id=l.tenant_id and m.id=l.membership_id and m.user_id=l.user_id and m.status='active'\n  where l.tenant_id=p_tenant_id and l.legal_entity_id=p_legal_entity_id and l.branch_id=p_branch_id and l.user_id=auth.uid() and l.status='accepted';\n if employee is null then raise exception using errcode='42501',message='HR_ACTIVE_LINK_REQUIRED';end if;\n select coalesce(jsonb_agg((people_payroll.payslip_payload(q.id)-'lines') order by q.id),'[]'::jsonb) into items\n  from(select id from people_payroll.payslips where tenant_id=p_tenant_id and legal_entity_id=p_legal_entity_id and branch_id=p_branch_id\n   and employee_id=employee and (p_after is null or id>p_after) order by id limit 51) q;\n return jsonb_build_object('tenant_id',p_tenant_id,'legal_entity_id',p_legal_entity_id,'branch_id',p_branch_id,'employee_id',employee,\n  'items',items-50,'next_cursor',case when jsonb_array_length(items)>50 then items->49->>'id' end);\nend $function$\n"
    }
  ]
