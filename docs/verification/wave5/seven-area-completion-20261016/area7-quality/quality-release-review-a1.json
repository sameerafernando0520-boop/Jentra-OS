  "area7Rows": [
    {
      "id": "FR-532",
      "fullStatement": "FR-532: Every provider adapter MUST advertise its supported contract revision and readiness; missing or incompatible providers MUST block only dependent operations and MUST not turn fixture data into live evidence.",
      "statementSha256": "c9db2a8fbe85645cfda098355b082314b39b7d9addeb72aeac4f72f2be32b444",
      "decision": "remain_open",
      "reason": "Actual installed provider readiness/missing/incompatible and dependent-operation isolation across all required adapters remain unproved; fixture success grants no live evidence."
    },
    {
      "id": "FR-533",
      "fullStatement": "FR-533: Wave 5 development MUST use additive owned paths, preserve concurrent Wave 3/4 work, and refresh source ownership before changing any shared composition, authorization, report, workflow, or finance contract.",
      "statementSha256": "22e7b6fe59d689db908c3c73919b717e4288944e96391a78c7422b871b76a7be",
      "decision": "remain_open",
      "reason": "The bounded current ownership is attributable; complete historical refresh for every shared composition/authorization/report/workflow/finance integration is not established."
    },
    {
      "id": "NFR-509",
      "fullStatement": "NFR-509: Analysis MUST report zero warnings/errors; critical changed domain branches MUST target at least 90% coverage, with deterministic fixtures for every acceptance criterion and edge case.",
      "statementSha256": "bdbe466982bcbc8f3d1cd92637e82c790acf5ee97b27aacbc70dd38ae9555eea",
      "decision": "remain_open",
      "reason": "Scoped changed-source analysis and controlled cases pass. Current whole-source zero-findings, critical-domain branch coverage tied to current source, and deterministic coverage of all criteria/edge cases remain required."
    },
    {
      "id": "AC-516",
      "fullStatement": "AC-516: Concurrent development boundary (FR-533, FR-534) Given an active Wave 3/4 checkout and installed-development ledger When Wave 5 changes and candidate verification occur Then owned paths remain attributable and candidate effects roll back without implicit installation.",
      "statementSha256": "6cc7b1dd4c87570002b2adee3fe98ef445ef95f6d33bd11a10ef09704dc601c1",
      "decision": "remain_open",
      "reason": "Historical rollback and installed ledger are distinct and retained; a complete concurrent shared-change attribution and integration history remains required."
    },
    {
      "id": "EC-515",
      "fullStatement": "EC-515: A parallel chat changes a shared provider signature or source file; refresh ownership/fingerprint before integration; verify with AC-516.",
      "statementSha256": "9ebb4d2913737b3cfba906530c9139dd0f6b15f4fcdfb7dd89317dd13e230896",
      "decision": "remain_open",
      "reason": "Current source fingerprints are refreshed here; a complete independently bound shared-provider drift/ownership integration event remains required."
    },
    {
      "id": "FR-560",
      "fullStatement": "FR-560: Development MUST use new slice-owned files first, with no edits to shared barrels, router, main, existing migrations, dashboard metrics, or process-event producers until ownership is refreshed for integration.",
      "statementSha256": "68d87f171f1da6e71370aa34350774bd43be18e4e6e16cb56ccf98ace850e43d",
      "decision": "remain_open",
      "reason": "Preserved first slice work and present ownership do not reconstruct every later shared barrel/router/main/migration/dashboard/producer ownership refresh."
    },
    {
      "id": "NFR-554",
      "fullStatement": "NFR-554: Deterministic domain cases MUST cover input permutations, exact boundaries, duplicates and malformed source rows; native previews MUST cover both themes/densities and 200% text, and source analysis MUST have zero findings.",
      "statementSha256": "373dfb02eccca0dace0ba00ca42bfde3823a4c838381355dd3ffe81c0e2d32d2",
      "decision": "remain_open",
      "reason": "Historical process fixtures and preview results exist, but complete current source-bound native theme/density/200% variants are not authenticated native acceptance."
    },
    {
      "id": "AC-558",
      "fullStatement": "AC-558: Source and quality contract (FR-551, FR-552, NFR-554) Given malformed scope/UTC/manifest data and a verified immutable definition When domain verification and analysis run Then invalid input is rejected deterministically and all required cases pass without analysis findings.",
      "statementSha256": "8d7adafad44676781025ba380e77b032f00f1fd17698b4d78c17a81a6f871506",
      "decision": "remain_open",
      "reason": "Malformed scope/UTC/manifest domain cases pass in retained evidence; linked complete provider snapshot and current native quality cases remain incomplete."
    }
  ],
