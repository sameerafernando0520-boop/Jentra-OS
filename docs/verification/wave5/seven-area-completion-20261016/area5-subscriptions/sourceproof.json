  "requirements": [
    {
      "id": "FR-524",
      "fullStatement": "FR-524: Plan, trial, seat, and entitlement changes MUST be versioned, effective-dated, privileged and audited; synthetic trials MUST have an explicit start/end and MUST not enable real subscriptions or paid billing.",
      "statementSha256": "c49bbf3826a5ab01944351e929ae995a89d72b5abd845148d0571742d21e8cd0",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Complete live effective-date plan/trial/seat/entitlement transitions, audited history and expiry with synthetic-only effects; one activation case is narrower."
    },
    {
      "id": "FR-525",
      "fullStatement": "FR-525: Metering MUST use append-only trusted-source usage events with deduplicated event identities and reasoned correction records; client reports MUST not be authoritative billable usage.",
      "statementSha256": "e5c8f73f3f1d72b1226c2e748d236cc86aabc07376bd44eef6a24be11a93ee12",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Complete duplicate trusted usage and reasoned correction readbacks, ensuring append-only history and rejection of client-authoritative metering."
    },
    {
      "id": "FR-526",
      "fullStatement": "FR-526: Enforced quotas and seats MUST use atomic reservations/settlement and explicit over-limit states; concurrent requests MUST not exceed a hard limit, and a denied command MUST not consume a business effect.",
      "statementSha256": "473b972517c7643fa01d1eadc309e74568cfd07fabaff750fd210783ba468503",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Complete every required independent overlapping quota/seat reservation race and explicit over-limit/no-effect denial with no hard-cap overshoot."
    },
    {
      "id": "AC-512",
      "fullStatement": "AC-512: Synthetic plans and trials (FR-524, FR-532) Given a synthetic tenant, scheduled plan changes and trial expiry When effective capabilities are resolved before and after the boundary Then entitlements follow audited versions and unsupported providers remain unavailable.",
      "statementSha256": "da34a73a983aeb561bd0337b6671448ff2b713a6b3c9d3ecaab09a5faf5d6cca",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Resolve audited synthetic entitlements before/after scheduled plan and trial boundaries, preserving unavailable unsupported provider states."
    },
    {
      "id": "AC-513",
      "fullStatement": "AC-513: Metering and hard limits (FR-525, FR-526, NFR-506) Given duplicate trusted usage events, correction records, and concurrent quota reservations When usage and remaining allowance are resolved Then history stays immutable and counted effects do not exceed the configured hard cap.",
      "statementSha256": "caf88c1510e30954e71615185514fb186e59700987251d2b84898817df20de7f",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Complete immutable trusted metering corrections/deduplication and concurrent quota/seat allowance proof against hard caps."
    },
    {
      "id": "EC-511",
      "fullStatement": "EC-511: Trial expiry and overlapping seat/usage reservations use server UTC and live effective versions, including a correction of prior usage; verify with AC-512/513.",
      "statementSha256": "f26e0c96ad2aea03f2286856305469b5a76879a2be26618cbdc5571859fcded6",
      "accepted": false,
      "decision": "open_missing_live_evidence",
      "remaining": "Complete live UTC trial/effective-version boundaries and overlapping seat/usage/correction races."
    }
  ],
