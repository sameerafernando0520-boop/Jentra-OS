      '  (SELECT count(*) FROM workflow.process_events WHERE tenant_id = $1::uuid) AS process_event_rows,\n' +
      '  (SELECT count(*) FROM core.currencies WHERE active) AS active_currency_codes) AS wave5_row)\n' +
      'SELECT wave5_result.rows,pg_catalog.pg_backend_pid() AS backend_id,\n' +
      'pg_catalog.txid_current_snapshot()::text AS snapshot_id,pg_catalog.statement_timestamp()::text AS observed_at,\n' +
      "pg_catalog.current_setting('transaction_read_only') AS read_only,\n" +
      "pg_catalog.current_setting('transaction_isolation') AS isolation FROM wave5_result"
    
