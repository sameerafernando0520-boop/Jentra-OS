  "findings": [
    {
      "path": "workers/wave5/openai_model_adapter.mjs",
      "detail": "Both input-token counting and generation use the privately supplied fetch transport. The reviewed source does not persist a complete external dispatch trace around those actual sends."
    },
    {
      "path": "workers/wave5/integration_policy.mjs",
      "detail": "Webhook dispatch uses pinned HTTPS and the original bounded signed bytes. Its outcome is retained separately from reservation/attempt rows; an attempt row precedes send and does not itself count a send."
    },
    {
      "path": "workers/wave5/edge_runtime.mjs",
      "detail": "The local active-request count is private to each handler instance. It is not an exposed complete remote active/inflight observation facility."
    },
    {
      "path": "tools/wave5/supabase_runtime_provider.mjs",
      "detail": "RPC traces are supplied to the required private observeExternalTransport hook. The public provider does not implement that complete remote-worker facility."
